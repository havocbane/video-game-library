{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Game Library",
  "identifier": "com.havoc.videogamelibrary",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Video Game Library",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2026 Joseph Bane",
    "homepage": "https://github.com/havocbane/video-game-library",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
